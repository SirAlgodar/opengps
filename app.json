{
  "expo": {
    "name": "OpenGPS",
    "slug": "opengps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2C3E50"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.opengps.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "OpenGPS precisa da sua localização para mostrar o mapa e navegar.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "OpenGPS precisa da localização em background para navegação contínua.",
        "NSLocationAlwaysUsageDescription": "OpenGPS usa sua localização para navegação contínua."
      }
    },
    "android": {
      "package": "com.opengps.app",
      "adaptiveIcon": {
        "backgroundColor": "#2C3E50",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "androidx.car.app.NAVIGATION_TEMPLATES",
        "androidx.car.app.ACCESS_SURFACE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "geo"
            },
            {
              "scheme": "https",
              "host": "maps.google.com"
            },
            {
              "scheme": "https",
              "host": "www.google.com",
              "pathPrefix": "/maps"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OpenGPS precisa da sua localização para mostrar o mapa e navegar.",
          "locationAlwaysAndWhenInUsePermission": "OpenGPS precisa da localização em background para navegação contínua.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-task-manager",
        {
          "taskName": "location-tracking"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8409b64b-451e-4aba-aec1-3189eec0d00f"
      }
    },
    "owner": "siralgodar"
  }
}
